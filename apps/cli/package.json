{
  "name": "@emdzej/stm-tunnel",
  "version": "0.3.0",
  "description": "WebSocket bridge for the STM web serial monitor \u2014 exposes a serial port (or a PTY-hosted command) to a browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emdzej/stm.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/emdzej/stm/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/emdzej/stm/issues"
  },
  "type": "module",
  "bin": {
    "stm-tunnel": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node --import tsx ./src/cli.ts",
    "dev": "node --watch --import tsx ./src/cli.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm build",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "serialport": "^13.0.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@emdzej/stm-tunnel-protocol": "workspace:*",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
