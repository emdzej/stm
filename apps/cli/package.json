{
  "name": "@emdzej/stm-tunnel",
  "version": "0.2.0",
  "description": "WebSocket bridge for the STM web serial monitor — exposes a serial port (or a PTY-hosted command) to a browser.",
  "type": "module",
  "bin": {
    "stm-tunnel": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node --import tsx ./src/cli.ts",
    "dev": "node --watch --import tsx ./src/cli.ts",
    "lint": "echo skip",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@emdzej/stm-tunnel-protocol": "workspace:*",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
