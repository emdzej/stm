{
  "name": "@emdzej/stm-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Web-based serial monitor and terminal (PWA).",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --dir src",
    "clean": "rm -rf dist .vite"
  },
  "dependencies": {
    "@emdzej/stm-logging": "workspace:*",
    "@emdzej/stm-serial-core": "workspace:*",
    "@emdzej/stm-serial-worker": "workspace:*",
    "@emdzej/stm-settings": "workspace:*",
    "@emdzej/stm-theme": "workspace:*",
    "@emdzej/stm-tunnel-protocol": "workspace:*",
    "@emdzej/stm-ui": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "workbox-window": "^7.4.1",
    "zmodem.js": "^0.1.10"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/w3c-web-serial": "^1.0.6",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
