{
  "name": "stm",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Web-based serial monitor and terminal. Web Serial or WebSocket tunnel.",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "web": "pnpm --filter @emdzej/stm-web dev",
    "web:build": "pnpm --filter @emdzej/stm-web build",
    "tunnel": "pnpm --filter @emdzej/stm-tunnel start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.19",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
